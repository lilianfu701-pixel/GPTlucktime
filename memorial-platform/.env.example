# Copy to .env.local for local development. Never commit real secrets.
# Secrets belong in the deployment platform's secret manager.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Minimum 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-plus-character-random-string

# --- Data ---
DATABASE_URL=postgres://memorial:memorial@localhost:5432/memorial_dev
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 compatible) ---
S3_BUCKET=memorial-dev
S3_REGION=us-west-2
# Optional: set for MinIO, R2 or any non-AWS endpoint
S3_ENDPOINT=

# --- Notification providers ---
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# --- Feature flags ---
# Phone sign-in is fully built and tested but hidden from the interface in phase one.
PHONE_AUTH_ENABLED=false
# Comma separated ISO 3166-1 alpha-2 codes, empty means no region is open.
PHONE_AUTH_REGIONS=
