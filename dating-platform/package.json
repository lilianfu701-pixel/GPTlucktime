{
  "name": "dating-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "realtime:start": "tsx realtime/main.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:acceptance:preflight:local": "tsx scripts/acceptance-preflight.ts local",
    "test:acceptance:preflight:external": "tsx scripts/acceptance-preflight.ts external",
    "test:acceptance:local": "tsx scripts/run-local-acceptance.ts",
    "test:acceptance:external": "tsx scripts/run-external-acceptance.ts",
    "test:acceptance": "npm run test:acceptance:local && npm run test:acceptance:external",
    "db:backup:test": "tsx scripts/verify-backup-restore.ts backup",
    "db:restore:verify": "tsx scripts/verify-backup-restore.ts restore",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@vercel/blob": "2.6.1",
    "better-auth": "^1.6.26",
    "bullmq": "^6.0.8",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.2.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.4.0",
    "tsx": "^4.23.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
