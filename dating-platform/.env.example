# Local development only. Replace every secret before using a deployed environment.
# Non-empty localhost/MinIO/realtime examples below are for independent local services only.
# Delete them or leave them empty in the Vercel free-test environment; do not copy this
# file wholesale into Vercel.
POSTGRES_DB=dating_platform
POSTGRES_USER=dating_platform
POSTGRES_PASSWORD=local_postgres_password
REDIS_PASSWORD=local_redis_password
MINIO_ROOT_USER=dating_platform
MINIO_ROOT_PASSWORD=local_minio_password

NODE_ENV=development
DATABASE_URL=postgresql://dating_platform:local_postgres_password@localhost:5432/dating_platform
REDIS_URL=redis://:local_redis_password@localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000/api/auth
APP_URL=http://localhost:3000

# Public free-test mode is server-only. Enable both variables together only on an
# HTTPS test deployment. Use a unique random access secret; never commit its value.
# In this mode, leave Stripe, email, SMS, identity-provider, E2E, and realtime-public
# variables empty. Only synthetic @datecn.test recipients and synthetic data are allowed.
FREE_TEST_MODE=
FREE_TEST_ACCESS_SECRET=

# Server-only ingress token. The ingress must strip public copies of
# x-auth-ingress-token/x-auth-client-ip before setting one normalized client IP.
AUTH_TRUSTED_PROXY_TOKEN=

# Active encryption key first, followed by old read keys: key-id:base64,key-id:base64.
# Keep both stable HMAC keys until all referenced outbox rows/intents have expired.
AUTH_ENCRYPTION_KEYS=
# Explicit read-only key for null-key-id rows. Use one base64 key if it was shared,
# or email:base64,sms:base64,identity:base64 when legacy providers used different keys.
AUTH_LEGACY_ENCRYPTION_KEY=
AUTH_DELIVERY_HMAC_KEY=
IDENTITY_IDEMPOTENCY_HMAC_KEY=

# Optional notification providers. Each channel is atomic with the crypto fields above.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_FALLBACK_WEBHOOK_URL=
EMAIL_FALLBACK_WEBHOOK_TOKEN=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_FALLBACK_WEBHOOK_URL=
SMS_FALLBACK_WEBHOOK_TOKEN=
SMS_ABUSE_HMAC_KEY=
SMS_ALLOWED_CALLING_CODES=
SMS_HIGH_RISK_CALLING_CODES=
SMS_DENIED_PREFIXES=

# Optional hosted identity-verification provider. Raw identity documents are never stored locally.
IDENTITY_VERIFICATION_PROVIDER=
IDENTITY_VERIFICATION_URL=
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
IDENTITY_REDIRECT_ORIGINS=

# Optional profile-media storage. Configure exactly one backend, never both:
# (1) BLOB_READ_WRITE_TOKEN, or (2) all five PROFILE_MEDIA_STORAGE_* S3 fields.
# Leave every S3 field empty when Blob is active, and leave Blob empty when S3 is active.
# PROFILE_MEDIA_TOKEN_SECRET is required with the selected backend. All credentials
# and upload-token secrets are server-only and must never use NEXT_PUBLIC_ names.
BLOB_READ_WRITE_TOKEN=
PROFILE_MEDIA_STORAGE_ENDPOINT=http://localhost:9000
PROFILE_MEDIA_STORAGE_REGION=us-east-1
PROFILE_MEDIA_STORAGE_BUCKET=profile-media
PROFILE_MEDIA_STORAGE_ACCESS_KEY=dating_platform
PROFILE_MEDIA_STORAGE_SECRET_KEY=local_minio_password
PROFILE_MEDIA_TOKEN_SECRET=replace-with-at-least-32-random-characters
PROFILE_MEDIA_MAX_BYTES=10485760
PROFILE_MEDIA_UPLOAD_EXPIRY_SECONDS=300
PROFILE_MEDIA_MAX_PHOTOS=6
# Optional encrypted privacy-export storage. Configure the full group together.
PRIVACY_EXPORT_S3_ENDPOINT=
PRIVACY_EXPORT_S3_REGION=
PRIVACY_EXPORT_S3_BUCKET=
PRIVACY_EXPORT_S3_ACCESS_KEY=
PRIVACY_EXPORT_S3_SECRET_KEY=
# 32 random bytes encoded as unpadded base64url (43 characters)
PRIVACY_EXPORT_ENCRYPTION_KEY=
PRIVACY_WORKER_CRON_SECRET=
NOTIFICATION_WORKER_CRON_SECRET=

# Optional encrypted admin-export storage. Configure the full group together.
ADMIN_EXPORT_S3_ENDPOINT=
ADMIN_EXPORT_S3_REGION=
ADMIN_EXPORT_S3_BUCKET=
ADMIN_EXPORT_S3_ACCESS_KEY=
ADMIN_EXPORT_S3_SECRET_KEY=

# Stripe billing is optional, but the application requires both server-only values together.
# Use test-mode placeholders for local acceptance; never commit real credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WORKER_CRON_SECRET=
ADMIN_WORKER_CRON_SECRET=

# Release-gate inputs. These are test-only and are rejected by production controls.
E2E_MODE=
E2E_CONTROL_TOKEN=
E2E_BASE_URL=
E2E_PORT=3200
E2E_DATABASE_PATH=.artifacts/e2e/member-acceptance-db-socket
E2E_DATABASE_PORT=55432
TEST_DATABASE_URL=
TEST_RESTORE_DATABASE_URL=
# Must exactly equal the restore database name (for example: dating_restore_e2e).
TEST_RESTORE_DATABASE_DISPOSABLE_CONFIRM=
E2E_BACKUP_PATH=.artifacts/e2e-release.dump
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_WEBHOOK_URL=

# Optional HTTPS malware/content/liveness review provider. Missing config stays pending/retryable.
MEDIA_REVIEW_PROVIDER=
MEDIA_REVIEW_URL=
MEDIA_REVIEW_API_KEY=
MEDIA_REVIEW_VERSION=
MEDIA_REVIEW_ALLOWED_ORIGINS=
MEDIA_REVIEW_REJECTED_RETENTION_HOURS=168
MEDIA_REVIEW_MAX_ATTEMPTS=5

# Optional bearer secret for an externally scheduled POST to the internal media worker route.
MEDIA_WORKER_CRON_SECRET=

# Optional comma-separated ISO country codes disabled by the server-side discovery policy.
DISCOVERY_DISABLED_COUNTRY_CODES=

# Optional server-only realtime ticket signing keys. Active key first, then old verification keys.
# Format: key-id:base64url-32+-byte-secret,key-id:base64url-32+-byte-secret
REALTIME_TICKET_KEYS=
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3100
REALTIME_POLL_MS=1000
# Browser-visible websocket origin for the independent local realtime service only.
# The current FREE_TEST_MODE validator does not reject this variable automatically.
# Vercel free-test operators must delete it or leave it empty so HTTP polling is used.
# A non-empty value in that environment is a failed release gate.
REALTIME_PUBLIC_URL=http://127.0.0.1:3100
