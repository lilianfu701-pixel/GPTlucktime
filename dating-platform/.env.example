# Local development only. Replace every secret before using a deployed environment.
POSTGRES_DB=dating_platform
POSTGRES_USER=dating_platform
POSTGRES_PASSWORD=local_postgres_password
REDIS_PASSWORD=local_redis_password
MINIO_ROOT_USER=dating_platform
MINIO_ROOT_PASSWORD=local_minio_password

NODE_ENV=development
DATABASE_URL=postgresql://dating_platform:local_postgres_password@localhost:5432/dating_platform
REDIS_URL=redis://:local_redis_password@localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000/api/auth
APP_URL=http://localhost:3000
