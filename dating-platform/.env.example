# Local development only. Replace every secret before using a deployed environment.
POSTGRES_DB=dating_platform
POSTGRES_USER=dating_platform
POSTGRES_PASSWORD=local_postgres_password
REDIS_PASSWORD=local_redis_password
MINIO_ROOT_USER=dating_platform
MINIO_ROOT_PASSWORD=local_minio_password

NODE_ENV=development
DATABASE_URL=postgresql://dating_platform:local_postgres_password@localhost:5432/dating_platform
REDIS_URL=redis://:local_redis_password@localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000/api/auth
APP_URL=http://localhost:3000

# Optional notification providers. Each channel is atomic; use a random 32-byte base64 payload key.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_PAYLOAD_ENCRYPTION_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_PAYLOAD_ENCRYPTION_KEY=
SMS_ABUSE_HMAC_KEY=
SMS_ALLOWED_CALLING_CODES=
SMS_HIGH_RISK_CALLING_CODES=
SMS_DENIED_PREFIXES=

# Optional hosted identity-verification provider. Raw identity documents are never stored locally.
IDENTITY_VERIFICATION_PROVIDER=
IDENTITY_VERIFICATION_URL=
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
IDENTITY_REDIRECT_ORIGINS=
IDENTITY_PAYLOAD_ENCRYPTION_KEY=
